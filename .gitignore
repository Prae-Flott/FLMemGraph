# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Virtual environments
.venv/
.venv_tts/
venv/
env/
report/
docs/*
!docs/img/
!docs/img/**


# Large data -- keep every dataset out of git except robo_fleet (MoboFleet,
# this project's own dataset, published alongside the paper). The other
# datasets (PUBearing/paderborn, ALFA, ME-AD, plus archived Sielaff/SMD raw
# data) are large and/or third-party; regenerate them locally via the
# benchmark/datasets/*_adapter.py / build_*.py scripts as needed.
data/*
!data/robo_fleet/
!data/robo_fleet/**

# Trained model weights AND sweep/ablation reports -- checkpoints/ is full of
# one-off experiment artifacts (calibration-mode sweeps, linkage comparisons,
# dated reruns, etc.), not just the shipped BK-mainline result. None of it
# belongs in the public repo; regenerate locally via the benchmark/run_*
# scripts as needed. (Local-only, same treatment as data/ below.)
checkpoints/

# Internal research log (experiment write-ups, dead ends, calibration
# history) -- useful locally, not meant for the public repo.
memory/

# ICRA presentation prep (script, slide drafts, raw/recorded video clips) --
# large media files and unpolished drafts, not meant for the public repo.
pre/

# Superseded/off-report code and artifacts moved aside during cleanup
# (Sielaff/SMD datasets, ablation-only scripts, retired robo3er-era code,
# stale registries/READMEs, old result dumps) -- kept for local history,
# not part of the report and not meant for the public repo.
archive/

# OS / editor cruft
.DS_Store
*.swp
.vscode/
.idea/

# Secrets -- never commit these even if they show up locally
.env
*.pem
*_token.txt
